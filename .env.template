# Klaudia — environment template. Copy to .env and fill in.

# Service
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=Klaudia Chatbot
VERSION=1.0.0
DEBUG=true
STAGE=development

# Local Compose infrastructure defaults (development only)
POSTGRES_USER=klaudia
POSTGRES_PASSWORD=klaudia
POSTGRES_DB=klaudia
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Database
# Used by native runs. Compose supplies its own in-network DATABASE_URL.
DATABASE_URL=postgresql://klaudia:klaudia@localhost:5432/klaudia
# Optional overrides for endpoints as seen FROM INSIDE Docker containers.
# Leave blank to use the local Compose services. Never use localhost for another container.
DATABASE_URL_CONTAINER=
REDIS_URL_CONTAINER=
TASKIQ_BROKER_URL_CONTAINER=
TASKIQ_RESULT_BACKEND_URL_CONTAINER=
MINIO_ENDPOINT_CONTAINER=

# MCP transports: stdio (default) or http (Streamable HTTP).
# HTTP requires a separately reachable endpoint; Compose uses stdio subprocesses.
MCP_TRANSPORT=stdio
MCP_LEDGER_URL=http://localhost:8003/mcp
MCP_AUTH_TOKEN=
MCP_JWT_SECRET=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
MCP_ALLOW_INSECURE_HTTP=false
# The insecure override also requires a loopback FASTMCP_HOST (for example 127.0.0.1).
# Explicit owner for standalone local MCP. The API forwards signed identity instead.
MCP_USER_ID=
FASTMCP_HOST=0.0.0.0
FASTMCP_STREAMABLE_HTTP_PATH=/mcp
# JSON arrays. Add the public MCP hostname and trusted browser origins for remote HTTP.
FASTMCP_HTTP_ALLOWED_HOSTS=["localhost","127.0.0.1","::1"]
FASTMCP_HTTP_ALLOWED_ORIGINS=[]

# Auth (self-issued JWT)
# MCP also uses this key to verify forwarded application tokens (32+ characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The development default is refused at startup when STAGE=production.
JWT_SECRET=
JWT_EXPIRES_DAYS=7
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute

# Main agent model
#   google   -> Gemini (Vertex AI or Dev API)
#   vllm     -> self-hosted Qwen on vLLM
#   deepseek -> DeepSeek API
MODEL_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.5
LLM_DISABLE_THINKING=true
# (provider=google only): minimal|low|medium|high
LLM_THINKING_LEVEL=minimal
# provider: google (Gemini)
# LLM_API_KEY used only when GOOGLE_GENAI_USE_VERTEXAI=False.
LLM_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=gcp_service_account.json
# Container path is overridden by Compose; place the file under secrets/.
GOOGLE_APPLICATION_CREDENTIALS_CONTAINER=/run/secrets/gcp_service_account.json

# provider: vllm (NOT the KIE server)
VLLM_LLM_ENDPOINT=
VLLM_LLM_API_KEY=

# provider: deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# KIE  (receipt extraction — independent of MODEL_PROVIDER). Backend = KIE_MODEL:
#   MOCK_KIE=true              → fixture from sample-data/labels (offline)
#   KIE_MODEL startswith deepseek → DeepSeek vision API, full zero-shot prompt
#   KIE_MODEL startswith gemini → Gemini, full zero-shot prompt (image→JSON)
#   KIE_MODEL anything else     → fine-tuned Qwen on vLLM (image-only)
MOCK_KIE=false
KIE_MODEL=deepseek-flash
# Fine-tuned KIE vLLM server (used when KIE_MODEL is not DeepSeek or Gemini).
# Full /v1/chat/completions URL. Separate box from the agentic vLLM above.
VLLM_KIE_ENDPOINT=
VLLM_KIE_API_KEY=

# Guardrails  (Deepseek or Gemini, + Groq, independent of MODEL_PROVIDER)
GUARDRAILS_ENABLED=true
LLM_GUARDRAILS_PROMPT_INJ=meta-llama/Llama-Prompt-Guard-2-86M
LLM_GUARDRAILS_MODEL=deepseek-flash
GROQ_API_KEY=

# Observability — Langfuse v4
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Storage & infrastructure
REDIS_URL=redis://localhost:6379/0
DEDUP_CACHE_TTL_SECONDS=86400
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
TASKIQ_QUEUE_NAME=ocr:extract
TASKIQ_RESULT_TTL_SECONDS=3600

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=klaudia-blobs
MINIO_SECURE=false

# Taskiq worker
WORKER_COUNT=1
WORKER_CONCURRENCY=8

# Extraction limits
EXTRACTION_MODE=async
EXTRACTION_CONTEXT_FORMAT=toon
EXTRACTION_PAGE_TIMEOUT_SECONDS=120
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=50
MAX_IMAGES_PER_UPLOAD=5
EXTRACTION_QUEUE_DEPTH_REJECT=200
OCR_SCHEMA_VERSION=v1
