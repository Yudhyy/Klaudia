# Klaudia — environment template. Copy to .env and fill in.

# Service
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=Klaudia Chatbot
VERSION=1.0.0
DEBUG=true
STAGE=development

# Database
# PostgreSQL is required. The default Compose service uses this local DSN.
DATABASE_URL=postgresql://klaudia:klaudia@localhost:5432/klaudia

# Sheets backend
# "gsheets" = Google Sheets API via mcp-gsheets (needs service account + SHEET_ID)
# "ledger"  = Postgres-backed mcp-ledger, same tool surface (needs DATABASE_URL)
SHEETS_BACKEND=ledger
# Main chat is the default; use legacy for the explicit fallback.
CHAT_RUNTIME=main

# MCP boundary. STDIO is the default local path. HTTP uses FastMCP 4's
# stateless /mcp endpoint; SSE is kept only as a legacy rollback mode.
MCP_TRANSPORT=stdio
MCP_ARCHIVE_URL=http://localhost:8001/mcp
MCP_LEDGER_URL=http://localhost:8003/mcp
MCP_GSHEETS_URL=http://localhost:8002/mcp
# HTTP only. MCP_AUTH_TOKEN must be a JWT signed by MCP_JWT_SECRET. Keep the
# shared HMAC secret separate from the user-facing JWT_SECRET below.
MCP_AUTH_TOKEN=
MCP_JWT_SECRET=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
# Local HTTP smoke tests only. Never enable on a remote or production host.
MCP_ALLOW_INSECURE_HTTP=false
FASTMCP_HOST=0.0.0.0

# Long-term memory (mem0 OSS, self-hosted). Vectors, edit history, and the recent
# extraction buffer use DATABASE_URL. Needs the pgvector Postgres image and the
# embedding service (services/embed). Reuses DEEPSEEK_* for fact extraction.
#   off   = disabled (default)
#   read  = retrieve memories into the prompt, but do not write
#   write = retrieve + persist turns in the background
MEMORY_MODE=off
# How a memory write runs when MEMORY_MODE=write:
#   inline = run mem0.add in an app background task (no worker; dev/CI default)
#   taskiq = enqueue to a Taskiq worker (durable, offloaded, retryable). Start a
#            worker that includes the memory task module:
#     taskiq worker app.services.extraction.queue.broker:broker \
#       app.services.extraction.queue.tasks app.services.core.memory_tasks
MEMORY_WRITE_MODE=inline
MEMORY_TOP_K=6
MEMORY_COLLECTION=klaudia_memory
MEMORY_LLM_MODEL=deepseek-flash
MEMORY_EMBED_BASE_URL=http://localhost:8100/v1
MEMORY_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
MEMORY_EMBED_DIMS=384

# Auth (self-issued JWT)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The dev default is refused at startup when STAGE=production.
JWT_SECRET=
JWT_EXPIRES_DAYS=7
# Edge rate limits (per-IP for auth, per-user for chat)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute

# AGENTIC LLM  (supervisor + sub-agents)
# Swap backend by editing MODEL_PROVIDER + LLM_MODEL only; each provider keeps
# its own credentials below. Guardrails and KIE have separate model settings.
#   google   → Gemini (Vertex AI or Dev API)   LLM_MODEL=gemini-3-flash-preview
#   vllm     → self-hosted Qwen on vLLM         LLM_MODEL=Qwen/Qwen3.5-27B
#   deepseek → DeepSeek API                     LLM_MODEL=deepseek-flash
MODEL_PROVIDER=google
LLM_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE=0.5
# Force reasoning off on the agentic stack (vllm/deepseek). Keep true: thinking
# returns reasoning_content that the react tool workers don't round-trip yet.
LLM_DISABLE_THINKING=true

# Gemini thinking budgets (provider=google only): minimal|low|medium|high
LLM_THINKING_LEVEL_ROUTING=minimal
LLM_THINKING_LEVEL_WORKER=minimal

# provider: google (Gemini)
# LLM_API_KEY used only when GOOGLE_GENAI_USE_VERTEXAI=False.
LLM_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=gcp_service_account.json

# provider: vllm (agentic Qwen — NOT the OCR server)
VLLM_LLM_ENDPOINT=
VLLM_LLM_API_KEY=

# provider: deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=

# KIE  (receipt extraction — independent of MODEL_PROVIDER). Backend = KIE_MODEL:
#   MOCK_KIE=true              → fixture from sample-data/labels (offline)
#   KIE_MODEL startswith deepseek → DeepSeek vision API, full zero-shot prompt
#   KIE_MODEL startswith gemini → Gemini, full zero-shot prompt (image→JSON)
#   KIE_MODEL anything else     → fine-tuned Qwen on vLLM (image-only)
MOCK_KIE=false
KIE_MODEL=deepseek-flash
# Fine-tuned KIE vLLM server (used when KIE_MODEL is not DeepSeek or Gemini).
# Full /v1/chat/completions URL. Separate box from the agentic vLLM above.
VLLM_KIE_ENDPOINT=
VLLM_KIE_API_KEY=

# Guardrails  (always Gemini + Groq, independent of MODEL_PROVIDER)
GUARDRAILS_ENABLED=true
LLM_GUARDRAILS_PROMPT_INJ=meta-llama/Llama-Prompt-Guard-2-86M
LLM_GUARDRAILS_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=

# Observability — Langfuse v4
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Storage & infrastructure
REDIS_URL=redis://localhost:6379/0
DEDUP_CACHE_TTL_SECONDS=86400

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=klaudia-blobs
MINIO_SECURE=false

# Extraction queue (Taskiq) + limits
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
TASKIQ_QUEUE_NAME=ocr:extract
TASKIQ_RESULT_TTL_SECONDS=3600

EXTRACTION_MODE=async
# Prompt-facing page data only. KIE, cache, database, and MCP data stay JSON.
EXTRACTION_CONTEXT_FORMAT=toon
EXTRACTION_PAGE_TIMEOUT_SECONDS=120
MAX_IMAGE_BYTES=10485760
MAX_PDF_BYTES=52428800
MAX_PDF_PAGES=50
MAX_IMAGES_PER_UPLOAD=5
EXTRACTION_QUEUE_DEPTH_REJECT=200
OCR_SCHEMA_VERSION=v1
