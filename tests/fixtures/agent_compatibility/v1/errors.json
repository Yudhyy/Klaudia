    }
  },
  "revision": {
    "tool": "inspect_resource",
    "arguments": {
      "table_id": "tbl_claims"
    },
    "response": {
      "content": "{\"error\": \"Source or catalogue changed; inspect again and refresh stale metadata before proposing new work. Retry existing operations only by their stored reference.\"}",
      "status": "error",
      "name": "inspect_resource"
    },
    "failure": {
      "type": "RevisionConflictError",
      "message": "Source changed"
    }
  },
