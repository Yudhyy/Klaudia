{
  "overlap": {
    "tool": "inspect_resource",
    "arguments": {
      "table_id": "tbl_claims"
    },
    "response": {
      "content": "{\"error\": \"Another registered table overlaps this region; inspect current placement and choose a non-overlapping region or clarify the intended existing table.\"}",
      "status": "error",
      "name": "inspect_resource"
    },
    "failure": {
      "type": "ResourceExistsError",
      "message": "Region overlaps"
    }
  },
  "missing": {
