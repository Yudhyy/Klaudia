{
  "schemas": {
    "AppendRows": {
      "additionalProperties": false,
      "description": "A bounded literal-value append based on an observed sheet revision.",
      "properties": {
        "sheet_id": {
          "exclusiveMinimum": 0,
          "title": "Sheet Id",
          "type": "integer"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Idempotency Key",
          "type": "string"
        },
        "rows": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxItems": 256,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "sheet_id",
        "expected_revision",
        "idempotency_key",
        "rows"
      ],
      "title": "AppendRows",
      "type": "object"
    },
