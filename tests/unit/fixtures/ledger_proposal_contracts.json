                  "maxLength": 256,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Entity"
            },
            "period_start": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Period Start"
            },
            "period_end": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Period End"
            }
          },
          "required": [
            "sheet_id",
            "expected_sheet_revision",
            "table_range",
            "name"
          ],
          "title": "TableRegistration",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "One explicit table lifecycle change with observed revision preconditions.",
      "properties": {
