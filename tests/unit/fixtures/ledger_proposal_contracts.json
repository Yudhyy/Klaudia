            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Catalogue Revision"
        },
        "expected_sheet_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sheet Revision"
        },
        "headers": {
          "anyOf": [
            {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headers"
        },
        "column_ids": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 256,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Ids"
        }
      },
      "required": [
        "action"
      ],
      "title": "AuthoringProposal",
      "type": "object"
    },
