              "minLength": 1,
              "title": "Table Range",
              "type": "string"
            },
            "name": {
              "maxLength": 256,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "description": {
              "default": "",
              "maxLength": 2000,
              "title": "Description",
              "type": "string"
            },
            "grain": {
              "default": "",
              "maxLength": 512,
              "title": "Grain",
              "type": "string"
            },
            "aliases": {
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 20,
